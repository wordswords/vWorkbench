#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

url=$1

if [[ $(id -u) -ne 0 ]] ; then
    printf '%s\n' 'You must be root to run this script'
    exit 1
fi

/bin/nohup /bin/screen -S Mirror-Erista -dm bash -c "/home/david/.dotfiles/bin/mirror-erista.sh $url" > /home/hqconfig/.mirror_erista.log 2>&1

